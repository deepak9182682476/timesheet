{% block timesheet_form %}
    {% form_theme form 'form/horizontal.html.twig' %}
    {% embed formOptions.template with formOptions %}
        {% block form_body %}
            {#
                People enter a date and a duration only. The start time, end time and customer fields are
                hidden rather than removed: they stay in the form (the app still needs their values), just out of sight.
                To show them again, delete the "d-none" wrappers below and restore the two-column layout.
            #}
            {% if form.begin_date is defined %}
                {# a new entry starts at a fixed time of day, so a few hours logged in the evening do not run past midnight #}
                {% set isNewEntry = form.vars.data is null or form.vars.data.id is null %}
                {% set fixedStart = form.begin_time.vars.time_format == 'HH:mm' ? '09:00' : '9:00 AM' %}
                <div class="mb-3 row">
                    <label class="col-form-label col-sm-2 required" for="{{ form.vars.name }}_begin_date">{{ 'date'|trans }}</label>
                    <div class="col-sm-10">
                        {{ form_widget(form.begin_date, {'label': false}) }}
                        {{ form_errors(form.begin_date, {'label': false}) }}
                        {{ form_errors(form.begin_time, {'label': false}) }}
                    </div>
                    {# start time: hidden #}
                    <div class="d-none">
                        {% if isNewEntry and not form.vars.submitted %}
                            {{ form_widget(form.begin_time, {'label': false, 'value': fixedStart}) }}
                        {% else %}
                            {{ form_widget(form.begin_time, {'label': false}) }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% if form.end_time is defined or form.duration is defined %}
                <div class="mb-3 row">
                    <label class="col-form-label col-sm-2{% if form.duration is defined %} required{% endif %}" for="{{ form.vars.name }}_duration">
                        {% if form.duration is defined %}
                            {{ 'duration'|trans }}
                        {% elseif form.end_time is defined %}
                            {{ 'endtime'|trans }}
                        {% endif %}
                    </label>
                    {% if form.duration is defined %}
                    <div class="col-sm-10">
                        {# with the end time hidden, an empty duration would start a running timer - so it has to be filled in #}
                        {{ form_widget(form.duration, {'label': false, 'attr': form.duration.vars.attr|merge({'required': 'required'})}) }}
                        {{ form_errors(form.duration, {'label': false}) }}
                        {% if form.end_time is defined %}{{ form_errors(form.end_time, {'label': false}) }}{% endif %}
                    </div>
                    {% endif %}
                    {# end time: hidden (shown only when the form has no duration field to enter instead) #}
                    {% if form.end_time is defined %}
                    <div class="{{ form.duration is defined ? 'd-none' : 'col-sm-10' }}">
                        {{ form_widget(form.end_time, {'label': false}) }}
                        {% if form.duration is not defined %}{{ form_errors(form.end_time, {'label': false}) }}{% endif %}
                    </div>
                    {% endif %}
                </div>
            {% else %}
                {% if form.duration is defined %}
                    {{ form_row(form.duration, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.duration.vars.name}}) }}
                {% endif %}
            {% endif %}

            {% if form.break is defined %}
                {{ form_row(form.break, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.break.vars.name}}) }}
            {% endif %}
            {#
                Type: Project, Non-project activities or Pre-sales. It decides which projects are offered and what is
                picked below the project. The script in partials/work-item-cascade.html.twig does the work.
            #}
            {% set workItems = (form.project is defined and form.metaFields is defined and form.metaFields.work_item is defined) ? work_item_form_data(form.vars.data, form.user is defined or form.users is defined) : null %}
            {% if workItems is not null %}
                <div class="mb-3 row {{ form.vars.name }}_row_type">
                    <label class="col-form-label col-sm-2 required" for="{{ form.vars.name }}_wi_type">Type</label>
                    <div class="col-sm-10">
                        <select class="form-select wi-type" id="{{ form.vars.name }}_wi_type">
                            <option value="project">Project</option>
                            <option value="nonproject">Non-Project Activities</option>
                            <option value="presales">Pre-Sales</option>
                        </select>
                    </div>
                </div>
            {% endif %}
            {# customer: hidden - the project list shows every project the person is mapped to, grouped by customer #}
            {% if form.customer is defined %}
                {{ form_row(form.customer, {'row_attr': {'class': 'd-none ' ~ form.vars.name ~ '_row_' ~ form.customer.vars.name}}) }}
            {% endif %}
            {% if form.project is defined %}
                {{ form_row(form.project, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.project.vars.name}}) }}
            {% endif %}
            {# The levels of the project's model (Epic > Feature > User Story > Activity > Task and the like) are built in here #}
            {% if workItems is not null %}
                <div class="wi-levels" data-work-items="{{ workItems|json_encode|e('html_attr') }}"></div>
            {% endif %}
            {# Phase (custom field): picked after the project; it narrows the activities. See partials/timesheet-cascade.html.twig #}
            {% if form.metaFields is defined and form.metaFields.phase is defined %}
                {{ form_row(form.metaFields.phase.value, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_phase'}}) }}
                {% do form.metaFields.phase.setRendered %}
            {% endif %}
            {% if form.activity is defined %}
                {{ form_row(form.activity, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.activity.vars.name}}) }}
            {% endif %}
            {# Task (custom field): placed after the activity, which narrows the tasks #}
            {% if form.metaFields is defined and form.metaFields.task is defined %}
                {{ form_row(form.metaFields.task.value, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_task'}}) }}
                {% do form.metaFields.task.setRendered %}
            {% endif %}
            {# Status (In progress / Completed) is a custom field; it is placed here, right below the activity, instead of with the other custom fields at the end #}
            {% if form.metaFields is defined and form.metaFields.status is defined %}
                {{ form_row(form.metaFields.status.value, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_status'}}) }}
                {% do form.metaFields.status.setRendered %}
            {% endif %}
            {% if form.description is defined %}
                {{ form_row(form.description, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.description.vars.name}}) }}
            {% endif %}
            {# "Worked on Leave": the reason, only on a day of approved leave. It stays hidden until "I worked during my leave"
               is ticked (partials/leave-day-guard.html.twig), and is shown when the entry has a reason or the date is a leave day. #}
            {% if form.metaFields is defined and form.metaFields.worked_on_leave is defined %}
                {% set wolField = form.metaFields.worked_on_leave.value %}
                {% set wolLeaveError = form.begin_date is defined and form.begin_date.vars.errors|filter(e => 'approved leave' in e.message)|length > 0 %}
                {% set wolShow = wolField.vars.value is not empty or wolLeaveError %}
                {{ form_row(wolField, {'row_attr': {'class': 'mb-3 worked-on-leave-row' ~ (wolShow ? '' : ' d-none')}}) }}
                {% do form.metaFields.worked_on_leave.setRendered %}
            {% endif %}
            {# Tags are hidden for now: the field is switched off in TimesheetEditForm.php, so this is skipped #}
            {% if form.tags is defined %}
                {{ form_row(form.tags, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.tags.vars.name}}) }}
            {% endif %}
            {% if form.user is defined %}
                {{ form_row(form.user, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.user.vars.name}}) }}
            {% endif %}
            {% if form.users is defined %}
                {{ form_row(form.users, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.users.vars.name}}) }}
            {% endif %}
            {% if form.teams is defined %}
                {{ form_row(form.teams, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.teams.vars.name}}) }}
            {% endif %}
            {# skipped when every custom field was already placed above (the form refuses to output a field twice) #}
            {% if form.metaFields is defined and form.metaFields is not empty and not form.metaFields.rendered %}
                {% for meta in form.metaFields.children %}
                    {% if meta.vars.data.formTheme is not null %}
                        {% form_theme meta meta.vars.data.formTheme %}
                    {% endif %}
                {% endfor %}
                {{ form_row(form.metaFields) }}
            {% endif %}
            {# "Extended settings" (rates, billable, exported) are hidden: the fields stay in the form with their values, out of sight.
            {% if form.fixedRate is defined or form.hourlyRate is defined or form.internalRate is defined or form.billable is defined or form.billableMode is defined or form.exported is defined %}
                {% embed '@theme/embeds/collapsible.html.twig' with {id: 'timesheet_extended_settings'} %}
                    {% import "macros/widgets.html.twig" as widgets %}
                    {% block title %}{{ 'extended_settings'|trans }}{% endblock %}
                    {% block body %}
                        {% if form.fixedRate is defined %}
                            {{ form_row(form.fixedRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.fixedRate.vars.name}}) }}
                        {% endif %}
                        {% if form.hourlyRate is defined %}
                            {{ form_row(form.hourlyRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.hourlyRate.vars.name}}) }}
                        {% endif %}
                        {% if form.internalRate is defined %}
                            {{ form_row(form.internalRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.internalRate.vars.name}}) }}
                        {% endif %}
                        {% if form.billable is defined %}
                            {{ form_row(form.billable, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.billable.vars.name}}) }}
                        {% elseif form.billableMode is defined %}
                            {{ form_row(form.billableMode, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.billableMode.vars.name}}) }}
                        {% endif %}
                        {% if form.exported is defined %}
                            {{ form_row(form.exported, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.exported.vars.name}}) }}
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            #}
            <div class="d-none">
                {% for field in ['fixedRate', 'hourlyRate', 'internalRate', 'billable', 'billableMode', 'exported'] %}
                    {% if attribute(form, field) is defined %}{{ form_row(attribute(form, field)) }}{% endif %}
                {% endfor %}
            </div>
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}