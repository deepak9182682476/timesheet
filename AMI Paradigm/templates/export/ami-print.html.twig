{% extends 'export/ami-layout.html.twig' %}
{# The timesheet as a page for the browser's print dialog. Layout: ami-layout.html.twig #}
{% block styles %}
        body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: #1f2933; }
        table { border-collapse: collapse; }
        .head { width: 100%; margin-bottom: 14px; }
        .head-title { vertical-align: top; }
        .head-facts { vertical-align: top; text-align: right; }
        .title { font-size: 26px; font-weight: bold; color: #102a43; }
        .subtitle { font-size: 15px; color: #52606d; margin-top: 2px; }
        .facts { margin-left: auto; }
        .fact-name { color: #52606d; padding: 1px 10px 1px 0; text-align: left; }
        .fact-value { text-align: right; padding: 1px 0; }
        .total { font-weight: bold; }
        .entries, .summary { border: 1px solid #cbd2d9; }
        .entries { width: 100%; }
        .entries th, .summary th { background-color: #e4e7eb; color: #102a43; font-weight: bold; text-align: left; padding: 5px 6px; border-bottom: 1px solid #9aa5b1; }
        .entries td, .summary td { padding: 4px 6px; vertical-align: top; border-bottom: 1px solid #e4e7eb; }
        .even td { background-color: #f5f7fa; }
        .col-date { white-space: nowrap; }
        .entries th.col-hours, .entries td.col-hours, .summary th.col-hours, .summary td.col-hours { text-align: right; white-space: nowrap; }
        .col-description { color: #3e4c59; }
        .entries tfoot td, .summary tfoot td { border-top: 1px solid #9aa5b1; border-bottom: 0; background-color: #e4e7eb; font-weight: bold; }
        .total-label { text-align: right; }
        .empty { color: #52606d; text-align: center; padding: 14px; }
        .summary-title { font-weight: bold; color: #102a43; margin: 18px 0 6px 0; font-size: 15px; }
        .summary { width: 45%; }

        body { margin: 0; background-color: #f0f2f5; }
        .sheet { background-color: #ffffff; max-width: 1200px; margin: 24px auto; padding: 28px 32px; }
        @media print {
            body { background-color: #ffffff; font-size: 10pt; }
            .sheet { max-width: none; margin: 0; padding: 0; }
            .entries thead { display: table-header-group; }
            .entries tr { page-break-inside: avoid; }
            @page { size: A4 landscape; margin: 10mm; }
        }
{% endblock %}
