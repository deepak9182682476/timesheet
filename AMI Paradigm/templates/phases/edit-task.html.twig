{% extends 'base.html.twig' %}

{% block main %}
    {% set formOptions = {
        'title': (task.id is null ? 'Add a task' : 'Edit task'),
        'form': form,
        'back': path('admin_phase')
    } %}
    {% embed 'default/_form.html.twig' with formOptions %}
        {% form_theme form 'form/horizontal.html.twig' %}
        {% block form_body %}
            {{ form_row(form.activity) }}
            {{ form_row(form.name) }}
            {{ form_row(form.position) }}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
