{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% macro status_badge(leave) %}
    {% set colors = {'pending': 'warning', 'approved': 'success', 'rejected': 'danger'} %}
    {% set labels = {'pending': 'Waiting for approval', 'approved': 'Approved', 'rejected': 'Rejected'} %}
    <span class="badge bg-{{ colors[leave.status] ?? 'secondary' }} text-white">{{ labels[leave.status] ?? leave.status }}</span>
    {% if not leave.pending and leave.decidedBy is not null and leave.decidedBy.id != leave.user.id %}
        <div class="text-secondary small">by {{ leave.decidedBy.displayName }}</div>
    {% endif %}
    {% if leave.status == 'rejected' and leave.decisionComment is not empty %}
        <div class="small mt-1"><span class="text-secondary">Reason:</span> {{ leave.decisionComment|nl2br }}</div>
    {% endif %}
{% endmacro %}

{% macro dates(leave) %}
    {{ leave.startDate|date_short }}{% if leave.multiDay %} &ndash; {{ leave.endDate|date_short }}{% endif %}
    <div class="text-secondary small">{{ leave_days(leave) }} {{ leave_days(leave) == 1 ? 'day' : 'days' }}</div>
{% endmacro %}

{% block main %}
    {% set token = csrf_token('leave_action') %}

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">My leave</h3>
            <div class="card-actions">
                <a href="{{ path('leave_apply') }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Apply for leave</a>
            </div>
        </div>
        {% if my_leave is empty %}
            <div class="card-body text-secondary">You have not applied for any leave. Use "Apply for leave" to send a request to your manager.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                    <tr>
                        <th>Dates</th>
                        <th>Leave type</th>
                        <th>Reason</th>
                        <th>{{ 'status'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for leave in my_leave %}
                        <tr>
                            <td class="text-nowrap">{{ _self.dates(leave) }}</td>
                            <td>{{ leave.title }}</td>
                            <td class="text-secondary">{{ leave.description|default('')|nl2br }}</td>
                            <td>{{ _self.status_badge(leave) }}</td>
                            <td class="text-nowrap">
                                {% if cancellable[leave.id] ?? false %}
                                    <form method="post" action="{{ path('leave_cancel', {'id': leave.id}) }}" class="leave-cancel-form">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {% if team_leave is not empty %}
        <div class="card mb-3" id="team-leave">
            <div class="card-header">
                <h3 class="card-title">Team leave requests</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                    <tr>
                        <th>Person</th>
                        <th>Dates</th>
                        <th>Leave type</th>
                        <th>Reason</th>
                        <th>{{ 'status'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for leave in team_leave %}
                        <tr>
                            <td class="text-nowrap">
                                {{ widgets.user_avatar(leave.user, false, 'avatar-rounded avatar-xs me-1') }}
                                {{ leave.user.displayName }}
                            </td>
                            <td class="text-nowrap">{{ _self.dates(leave) }}</td>
                            <td>{{ leave.title }}</td>
                            <td class="text-secondary">{{ leave.description|default('')|nl2br }}</td>
                            <td>{{ _self.status_badge(leave) }}</td>
                            <td class="text-nowrap">
                                {% if leave.pending and (decidable[leave.id] ?? false) %}
                                    <div class="btn-list flex-nowrap justify-content-end">
                                        <form method="post" action="{{ path('leave_decide', {'id': leave.id, 'decision': 'approve'}) }}">
                                            <input type="hidden" name="_token" value="{{ token }}">
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        {# opens the "reason" box below; the reason is optional #}
                                        <button type="button" class="btn btn-sm btn-outline-danger leave-reject-button" data-action="{{ path('leave_decide', {'id': leave.id, 'decision': 'reject'}) }}" data-who="{{ leave.user.displayName }}" data-what="{{ leave.title }}">Reject</button>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <script type="text/javascript">
        // ask before withdrawing a leave request
        document.querySelectorAll('.leave-cancel-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!window.confirm('Cancel this leave?')) {
                    event.preventDefault();
                }
            });
        });
    </script>
    {# Reject a leave request: asks for the reason first. The reason can be left empty. #}
    <div class="modal modal-blur fade" id="leave-reject-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <form method="post" action="#" class="modal-content" id="leave-reject-form">
                <input type="hidden" name="_token" value="{{ csrf_token('leave_action') }}" id="leave-reject-token">
                <div class="modal-header">
                    <h5 class="modal-title">Reject leave request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3" id="leave-reject-summary"></p>
                    <label class="form-label" for="leave-reject-comment">Reason for rejecting <span class="text-secondary">(optional)</span></label>
                    <textarea class="form-control" name="comment" id="leave-reject-comment" rows="3" maxlength="1000" placeholder="Let them know why the leave is rejected"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject leave</button>
                </div>
            </form>
        </div>
    </div>
    <script type="text/javascript">
        (function () {
            var modal = document.getElementById('leave-reject-modal');
            var form = document.getElementById('leave-reject-form');
            if (modal === null || form === null) { return; }
            function close() { modal.classList.remove('show'); modal.style.display = 'none'; document.body.classList.remove('modal-open'); var b = document.getElementById('leave-reject-backdrop'); if (b !== null) { b.remove(); } }
            document.querySelectorAll('.leave-reject-button').forEach(function (button) {
                button.addEventListener('click', function () {
                    form.action = button.dataset.action;
                    // the same token the Approve button next to it sends
                    var token = button.closest('td').querySelector('input[name="_token"]');
                    if (token !== null) { document.getElementById('leave-reject-token').value = token.value; }
                    document.getElementById('leave-reject-summary').textContent = 'Reject the ' + button.dataset.what.toLowerCase() + ' request of ' + button.dataset.who + '?';
                    document.getElementById('leave-reject-comment').value = '';
                    var backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.id = 'leave-reject-backdrop';
                    document.body.appendChild(backdrop);
                    modal.style.display = 'block';
                    modal.classList.add('show');
                    document.body.classList.add('modal-open');
                    document.getElementById('leave-reject-comment').focus();
                });
            });
            modal.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function (el) { el.addEventListener('click', close); });
            modal.addEventListener('click', function (event) { if (event.target === modal) { close(); } });
            document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && modal.classList.contains('show')) { close(); } });
        })();
    </script>
{% endblock %}
