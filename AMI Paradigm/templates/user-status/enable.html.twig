{% extends 'base.html.twig' %}

{% block main %}
    {% set formOptions = {
        'title': 'Enable ' ~ person.displayName,
        'form': form,
        'back': path('admin_user')
    } %}
    {% embed 'default/_form.html.twig' with formOptions %}
        {% block form_body %}
            <p><strong>{{ person.displayName }}</strong> ({{ person.userIdentifier }}) will be able to log in again.</p>
            {% if reason is not empty %}
                <div class="alert alert-info">
                    <div>Disabled{% if when %} on {{ when }}{% endif %}{% if by %} by {{ by }}{% endif %}.<br>
                    Reason: {{ reason }}</div>
                </div>
            {% endif %}
            <p class="text-muted">The person was taken out of their teams when they were disabled. Add them again on the "Team Allocation" page.</p>
            {{ form_rest(form) }}
        {% endblock %}
        {% block submit_button %}<button type="submit" class="btn btn-primary">Enable</button>{% endblock %}
    {% endembed %}
{% endblock %}
