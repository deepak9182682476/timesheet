{% extends 'base.html.twig' %}

{# Asking for a comp-off: what was worked, and the day to take off (see CompOffController for the rules) #}
{% block main %}
    {% set formOptions = {
        'title': 'Request Comp-Off',
        'form': form,
        'back': path('comp_off'),
        'submit_button': 'Send Request'
    } %}
    {% embed 'default/_form.html.twig' with formOptions %}
        {% form_theme form 'form/horizontal.html.twig' %}
        {% block form_body %}
            <div class="mb-3 row">
                <div class="col-sm-2"></div>
                <div class="col-sm-10">
                    <div class="text-secondary small">
                        Worked on a weekend, a festival or holiday, or a night shift? Ask for a day (or half day) off for it.
                        Your manager approves it; once approved it is in your timesheet and your teammates see it on Notifications.
                    </div>
                </div>
            </div>
            <h4 class="mb-3 text-secondary text-uppercase small">The day you worked</h4>
            {{ form_row(form.compWorkedDate) }}
            {{ form_row(form.compReason) }}
            {{ form_row(form.compWorkedHours) }}
            {{ form_row(form.description) }}
            <h4 class="mb-3 mt-4 text-secondary text-uppercase small">The day you take off</h4>
            {{ form_row(form.startDate) }}
            {{ form_row(form.compHalfDay) }}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
