{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{# Team Allocation (was Team Mapping): Project Managers and Project Leads put their teams together (see TeamMappingController) #}
{% block main %}
    {% set csrf = csrf_token(token) %}

    {% if notice %}
        <div class="alert alert-success alert-dismissible mb-3" role="alert">
            <div>{{ notice }}</div>
            <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
        </div>
    {% endif %}

    <datalist id="team-roles">
        {% for role in roles %}<option value="{{ role }}">{% endfor %}
    </datalist>

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">My Teams</h3>
            <div class="card-actions">
                <a href="{{ path('team_mapping', {'new': 1}) }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Team</a>
            </div>
        </div>
        {% if teams is empty %}
            <div class="card-body text-secondary">
                You do not lead a team yet. Use "New Team" to put one together: link its projects, add the people
                the project needs and say what each one does there.
            </div>
        {% else %}
            <div class="card-body py-2">
                <ul class="nav nav-pills team-pills">
                    {% for team in teams %}
                        <li class="nav-item">
                            <a class="nav-link{% if selected is not null and selected.id == team.id %} active{% endif %}" href="{{ path('team_mapping', {'team': team.id}) }}">
                                {{ team.name }} <span class="badge bg-secondary-lt ms-1">{{ team.members|length }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>

    {% if creating %}
        {# a new team #}
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title">New Team</h3></div>
            <form method="post" action="{{ path('team_mapping_create') }}">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label required" for="team-name">Team name</label>
                            <input type="text" class="form-control team-name-input" id="team-name" name="name" maxlength="100" required autofocus placeholder="For example hmel">
                            <div class="invalid-feedback">Team name already exists. Choose another name.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="team-projects">Projects</label>
                            <select class="form-select team-select" id="team-projects" name="projects[]" multiple>
                                {% for id, name in projects %}<option value="{{ id }}" data-start="{{ project_dates[id].start ?? '' }}" data-end="{{ project_dates[id].end ?? '' }}">{{ name }}</option>{% endfor %}
                            </select>
                            <div class="form-hint">A linked project is offered only to the people of its teams.</div>
                            {# <div class="team-project-dates" data-for="team-projects"></div> - now a full-width row below #}
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="my-role">Your roles in the project</label>
                            {% set myDefault = is_granted('ROLE_ADMIN') ? 'Project Manager' : 'Project Lead' %}
                            <select class="form-select team-select" id="my-role" name="my_role[]" multiple data-create="1">
                                {% for role in roles %}<option value="{{ role }}"{% if role == myDefault %} selected{% endif %}>{{ role }}</option>{% endfor %}
                            </select>
                            <div class="form-hint">You are the lead of the team you create.</div>
                        </div>
                        <div class="col-12">
                            <div class="team-project-dates" data-for="team-projects"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Create Team</button>
                    {% if teams is not empty %}<a href="{{ path('team_mapping') }}" class="btn btn-link">{{ 'back'|trans }}</a>{% endif %}
                </div>
            </form>
        </div>
    {% else %}
        {# the selected team: its name and projects #}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ selected.name }}</h3>
                <div class="card-actions">
                    <form method="post" action="{{ path('team_mapping_delete', {'id': selected.id}) }}" class="d-inline team-delete-form" data-name="{{ selected.name }}">
                        <input type="hidden" name="_token" value="{{ csrf }}">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete Team</button>
                    </form>
                </div>
            </div>
            <form method="post" action="{{ path('team_mapping_update', {'id': selected.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-4 mb-3">
                            <label class="form-label required" for="team-name">Team name</label>
                            <input type="text" class="form-control team-name-input" id="team-name" name="name" maxlength="100" required value="{{ selected.name }}">
                            <div class="invalid-feedback">Team name already exists. Choose another name.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="team-projects">Projects</label>
                            <select class="form-select team-select" id="team-projects" name="projects[]" multiple>
                                {% for id, name in projects %}<option value="{{ id }}" data-start="{{ project_dates[id].start ?? '' }}" data-end="{{ project_dates[id].end ?? '' }}"{% if id in linked %} selected{% endif %}>{{ name }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <button type="submit" class="btn w-100">{{ 'action.save'|trans }}</button>
                        </div>
                        <div class="col-12">
                            <div class="team-project-dates" data-for="team-projects"></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        {# who is in the team and what they do #}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">People in {{ selected.name }}</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                    <tr>
                        <th>Person</th>
                        <th>Role in the System</th>
                        <th style="min-width: 200px">Role in the Project</th>
                        {# the person's Allocation ID on each project of the team, and its periods (Allocation No. 1, 2 ...) #}
                        <th style="min-width: 210px">Allocation</th>
                        {# <th class="text-center">Team lead</th> #}
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for member in members %}
                        {% set person = member.user %}
                        {% set formId = 'member-' ~ person.id %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {{ widgets.user_avatar(person, false, 'avatar-rounded avatar-sm') }}
                                    <span class="fw-bold">{{ person.displayName }}</span>
                                    {% if person.id == app.user.id %}<span class="text-secondary">(you)</span>{% endif %}
                                </div>
                            </td>
                            <td class="text-secondary">{{ widgets.user_role_name(person) }}</td>
                            <td>
                                {# one or several roles; a role that is not in the list can be typed in #}
                                {% set mine = member.teamRoles %}
                                <select class="form-select team-select" name="role[]" form="{{ formId }}" multiple data-create="1" data-placeholder="Choose or type roles">
                                    {% for role in mine|filter(r => r not in roles) %}<option value="{{ role }}" selected>{{ role }}</option>{% endfor %}
                                    {% for role in roles %}<option value="{{ role }}"{% if role in mine %} selected{% endif %}>{{ role }}</option>{% endfor %}
                                </select>
                            </td>
                            <td>
                                {% for projectId, projectName in linked_projects %}
                                    {% set alloc = allocations[person.id][projectId] ?? null %}
                                    <div class="alloc-block{% if not loop.last %} mb-2{% endif %}">
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            {% if linked_projects|length > 1 %}<span class="fw-bold small">{{ projectName }}</span>{% endif %}
                                            {% if alloc is not null %}<span class="badge bg-blue-lt" title="Allocation ID">{{ alloc.code }}</span>{% endif %}
                                            <button type="button" class="btn btn-sm btn-ghost-primary py-0 px-1 alloc-add" data-user="{{ person.id }}" data-name="{{ person.displayName }}" data-project="{{ projectId }}"><i class="fas fa-plus me-1"></i>Add Period</button>
                                        </div>
                                        {% if alloc is null or alloc.periods is empty %}
                                            <div class="text-danger small">Not allocated yet: add the From and To dates.</div>
                                        {% else %}
                                            {% for period in alloc.periods %}
                                                <div class="d-flex align-items-center gap-1 small alloc-period">
                                                    <span class="text-secondary">No. {{ period.number }}:</span>
                                                    <span>{{ period.from|date('d M Y') }} &rarr; {{ period.to|date('d M Y') }}</span>
                                                    <form method="post" action="{{ path('team_mapping_allocation_remove', {'id': selected.id, 'period': period.id}) }}" class="d-inline alloc-remove-form" data-what="{{ alloc.code }} Allocation No. {{ period.number }}">
                                                        <input type="hidden" name="_token" value="{{ csrf }}">
                                                        <button type="submit" class="btn btn-sm btn-ghost-danger py-0 px-1" title="Remove this period">&times;</button>
                                                    </form>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-secondary small">Link a project to the team first.</span>
                                {% endfor %}
                            </td>
                            {# Team lead column hidden: who leads a team stays as it is (the person who created it)
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" name="lead" value="1" form="{{ formId }}"{% if member.teamlead %} checked{% endif %}>
                            </td> #}
                            {# Save above Remove so the buttons stay inside the window #}
                            <td class="text-nowrap">
                                <div class="d-flex flex-column gap-1">
                                <form method="post" id="{{ formId }}" action="{{ path('team_mapping_member', {'id': selected.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf }}">
                                    <input type="hidden" name="user" value="{{ person.id }}">
                                    <button type="submit" class="btn btn-sm w-100">{{ 'action.save'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('team_mapping_member_remove', {'id': selected.id, 'user': person.id}) }}" class="member-remove-form" data-name="{{ person.displayName }}">
                                    <input type="hidden" name="_token" value="{{ csrf }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove</button>
                                </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    {# add somebody #}
                    {% set inTeam = members|map(m => m.user.id) %}
                    <tr class="bg-light-subtle">
                        <td colspan="2">
                            <select class="form-select team-select" name="user" form="member-new" required>
                                <option value="">Add a person …</option>
                                {% for person in people|filter(p => p.id not in inTeam) %}
                                    <option value="{{ person.id }}">{{ person.displayName }} · {{ widgets.user_role_name(person) }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <select class="form-select team-select" name="role[]" form="member-new" multiple data-create="1" data-placeholder="Choose or type roles">
                                {% for role in roles %}<option value="{{ role }}">{{ role }}</option>{% endfor %}
                            </select>
                        </td>
                        {# the first allocation of the new person: From and To, within the project dates (mandatory) #}
                        <td>
                            {% if linked_projects is not empty %}
                                {# From above To so the row stays inside the window #}
                                <div class="d-flex flex-column gap-1">
                                    <input type="date" class="form-control form-control-sm alloc-range-from" name="alloc_from" form="member-new" required title="Allocation from">
                                    <input type="date" class="form-control form-control-sm alloc-range-to" name="alloc_to" form="member-new" required title="Allocation to">
                                </div>
                                <div class="text-secondary small mt-1">Allocation from and to (required)</div>
                            {% endif %}
                        </td>
                        {# <td class="text-center">
                            <input type="checkbox" class="form-check-input" name="lead" value="1" form="member-new">
                        </td> #}
                        <td>
                            <form method="post" id="member-new" action="{{ path('team_mapping_member', {'id': selected.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf }}">
                                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add</button>
                            </form>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-secondary small">
                "Role in the System" (Employee, Project Lead, Project Manager) is set by the administrator.
                "Role in the Project" is what the person does in this project: pick one or more from the list, or type a new one and press Enter.
                Only active people can be added.
            </div>
        </div>
    {% endif %}

    {% if selected is not null and linked_projects is defined and linked_projects is not empty %}
        {# another period on a project: the next Allocation No. #}
        <div class="modal modal-blur fade" id="alloc-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <form method="post" action="{{ path('team_mapping_allocation', {'id': selected.id}) }}" class="modal-content" id="alloc-form">
                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                    <input type="hidden" name="user" id="alloc-user">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Allocation Period</h5>
                        <button type="button" class="btn-close alloc-close" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3" id="alloc-who"></p>
                        <div class="mb-3">
                            <label class="form-label required" for="alloc-project">Project</label>
                            <select class="form-select" name="project" id="alloc-project" required>
                                {% for projectId, projectName in linked_projects %}
                                    <option value="{{ projectId }}" data-start="{{ project_dates[projectId].start ?? '' }}" data-end="{{ project_dates[projectId].end ?? '' }}">{{ projectName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-2">
                                <label class="form-label required" for="alloc-from">From</label>
                                <input type="date" class="form-control" name="alloc_from" id="alloc-from" required>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label required" for="alloc-to">To</label>
                                <input type="date" class="form-control" name="alloc_to" id="alloc-to" required>
                            </div>
                        </div>
                        <div class="text-secondary small" id="alloc-hint"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary me-auto alloc-close">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Period</button>
                    </div>
                </form>
            </div>
        </div>
        <script type="text/javascript">
            (function () {
                var modal = document.getElementById('alloc-modal');
                var project = document.getElementById('alloc-project');
                var from = document.getElementById('alloc-from');
                var to = document.getElementById('alloc-to');
                var hint = document.getElementById('alloc-hint');
                var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                function pretty(value) { if (!value) { return 'not set'; } var p = value.split('-'); return p[2] + ' ' + MONTHS[parseInt(p[1], 10) - 1] + ' ' + p[0]; }
                /* the dates can only be picked within the project's start and end date */
                function limits() {
                    var option = project.selectedOptions[0];
                    var start = option ? option.dataset.start : '', end = option ? option.dataset.end : '';
                    [from, to].forEach(function (input) { input.min = start || ''; input.max = end || ''; });
                    hint.textContent = 'Within the project dates: ' + pretty(start) + ' to ' + pretty(end) + '. Periods of one person on a project cannot overlap.';
                }
                function keepOrder() { to.min = from.value || (project.selectedOptions[0] ? project.selectedOptions[0].dataset.start : '') || ''; }
                project.addEventListener('change', limits);
                from.addEventListener('change', keepOrder);
                function show() { modal.style.display = 'block'; modal.classList.add('show'); var b = document.createElement('div'); b.className = 'modal-backdrop fade show'; b.id = 'alloc-backdrop'; document.body.appendChild(b); }
                function hide() { modal.style.display = 'none'; modal.classList.remove('show'); var b = document.getElementById('alloc-backdrop'); if (b) { b.remove(); } }
                modal.querySelectorAll('.alloc-close').forEach(function (el) { el.addEventListener('click', function (e) { e.preventDefault(); hide(); }); });
                document.querySelectorAll('.alloc-add').forEach(function (button) {
                    button.addEventListener('click', function () {
                        document.getElementById('alloc-user').value = button.dataset.user;
                        document.getElementById('alloc-who').textContent = 'A new period for ' + button.dataset.name + ' (the next Allocation No.).';
                        project.value = button.dataset.project;
                        from.value = ''; to.value = '';
                        limits();
                        show();
                    });
                });
                document.querySelectorAll('.alloc-remove-form').forEach(function (form) {
                    form.addEventListener('submit', function (event) { if (!window.confirm('Remove ' + form.dataset.what + '?')) { event.preventDefault(); } });
                });
                /* adding a person: their first period must fit every project of the team */
                var starts = [], ends = [];
                Array.prototype.forEach.call(project.options, function (option) { if (option.dataset.start) { starts.push(option.dataset.start); } if (option.dataset.end) { ends.push(option.dataset.end); } });
                var newFrom = document.querySelector('.alloc-range-from'), newTo = document.querySelector('.alloc-range-to');
                if (newFrom && newTo) {
                    var min = starts.length ? starts.sort().slice(-1)[0] : '', max = ends.length ? ends.sort()[0] : '';
                    [newFrom, newTo].forEach(function (input) { input.min = min; input.max = max; });
                    newFrom.addEventListener('change', function () { newTo.min = newFrom.value || min; });
                }
            })();
        </script>
    {% endif %}

    <style>
        .team-pills .nav-link { border: 1px solid var(--tblr-border-color); margin: .25rem .5rem .25rem 0; }
        .team-pills .nav-link.active { font-weight: 600; }
        /* project timeline under the team's projects */
        .team-project-dates .pt-title { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--tblr-secondary); margin: .25rem 0 .5rem; }
        .team-project-dates .pt-list { display: flex; flex-wrap: wrap; gap: .75rem; }
        .team-project-dates .pt-card { min-width: 260px; flex: 0 1 320px; border: 1px solid var(--tblr-border-color); border-left: 4px solid var(--tblr-primary); border-radius: 6px; padding: .65rem .85rem; background: var(--tblr-bg-surface); }
        .team-project-dates .pt-ongoing { border-left-color: var(--tblr-green); }
        .team-project-dates .pt-upcoming { border-left-color: var(--tblr-azure); }
        .team-project-dates .pt-ended, .team-project-dates .pt-unset { border-left-color: var(--tblr-border-color-dark, #c7ccd4); }
        .team-project-dates .pt-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .45rem; }
        .team-project-dates .pt-name { font-weight: 600; }
        .team-project-dates .pt-range { display: flex; align-items: center; gap: .75rem; }
        .team-project-dates .pt-label { font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--tblr-secondary); }
        .team-project-dates .pt-value { font-weight: 500; white-space: nowrap; }
        .team-project-dates .pt-unset { color: var(--tblr-secondary); font-weight: 400; font-style: italic; }
        .team-project-dates .pt-arrow { color: var(--tblr-secondary); font-size: 1.1rem; padding-top: .8rem; }
        .team-project-dates .pt-length { margin-top: .35rem; font-size: .75rem; color: var(--tblr-secondary); }
    </style>
    <script type="text/javascript">
        document.querySelectorAll('.team-delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!window.confirm('Delete the team "' + form.dataset.name + '"? Its people stay in the system; only the team and its links go.')) {
                    event.preventDefault();
                }
            });
        });
        document.querySelectorAll('.member-remove-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!window.confirm('Take ' + form.dataset.name + ' out of this team?')) {
                    event.preventDefault();
                }
            });
        });
        // ---- a team name that is taken (whatever the capitals and spaces: "citms", "CITMS", "CiTms") is refused at once
        (function () {
            var taken = {{ taken_names|json_encode|raw }};
            function key(name) { return name.replace(/\s+/g, ' ').trim().toLowerCase(); }
            document.querySelectorAll('.team-name-input').forEach(function (input) {
                var form = input.form;
                function check() {
                    var bad = taken.indexOf(key(input.value)) !== -1;
                    input.classList.toggle('is-invalid', bad);
                    input.setCustomValidity(bad ? 'Team name already exists.' : '');
                }
                input.addEventListener('input', check);
                check();
                form.addEventListener('submit', function (event) {
                    check();
                    if (input.classList.contains('is-invalid')) { event.preventDefault(); input.focus(); }
                });
            });
        })();

        /* earlier: a plain table Project | From | To
        // ---- the start and end date of the picked projects, as the administrator entered them (shown only)
        function showProjectDates() {
            document.querySelectorAll('.team-project-dates').forEach(function (box) {
                var select = document.getElementById(box.dataset.for);
                if (select === null) { return; }
                var picked = Array.prototype.filter.call(select.options, function (option) { return option.selected; });
                box.innerHTML = '';
                if (picked.length === 0) { return; }
                var table = document.createElement('table');
                table.className = 'table table-sm table-borderless mb-0 mt-2 small';
                var head = table.createTHead().insertRow();
                ['Project', 'From', 'To'].forEach(function (label) {
                    var th = document.createElement('th');
                    th.className = 'text-secondary fw-normal ps-0';
                    th.textContent = label;
                    head.appendChild(th);
                });
                var body = table.createTBody();
                picked.forEach(function (option) {
                    var row = body.insertRow();
                    [option.textContent, option.dataset.start || 'Not set', option.dataset.end || 'Not set'].forEach(function (text, index) {
                        var cell = row.insertCell();
                        cell.className = 'ps-0' + (index > 0 && text === 'Not set' ? ' text-secondary' : '');
                        cell.textContent = text;
                    });
                });
                box.appendChild(table);
            });
        }
        */
        // ---- the timeline of the picked projects: start and end date as the administrator entered them (shown only)
        var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        function parseDay(value) {
            if (!value) { return null; }
            var p = value.split('-');
            return new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
        }
        function writeDay(date) {
            return (date.getDate() < 10 ? '0' : '') + date.getDate() + ' ' + MONTHS[date.getMonth()] + ' ' + date.getFullYear();
        }
        function el(tag, className, text) {
            var node = document.createElement(tag);
            if (className) { node.className = className; }
            if (text !== undefined) { node.textContent = text; }
            return node;
        }
        function showProjectDates() {
            var today = new Date(); today.setHours(0, 0, 0, 0);
            document.querySelectorAll('.team-project-dates').forEach(function (box) {
                var select = document.getElementById(box.dataset.for);
                if (select === null) { return; }
                var picked = Array.prototype.filter.call(select.options, function (option) { return option.selected; });
                box.innerHTML = '';
                if (picked.length === 0) { return; }
                box.appendChild(el('div', 'pt-title', 'Project Timeline'));
                var list = el('div', 'pt-list');
                picked.forEach(function (option) {
                    var start = parseDay(option.dataset.start);
                    var end = parseDay(option.dataset.end);
                    var status = null;
                    if (start !== null && today < start) { status = ['Upcoming', 'bg-azure-lt']; }
                    else if (end !== null && today > end) { status = ['Ended', 'bg-secondary-lt']; }
                    else if (start !== null || end !== null) { status = ['Ongoing', 'bg-green-lt']; }

                    var card = el('div', 'pt-card pt-' + (status !== null ? status[0].toLowerCase() : 'unset'));
                    var head = el('div', 'pt-head');
                    head.appendChild(el('span', 'pt-name', option.textContent));
                    if (status !== null) { head.appendChild(el('span', 'badge ' + status[1], status[0])); }
                    card.appendChild(head);

                    var range = el('div', 'pt-range');
                    [['From', start], ['To', end]].forEach(function (part, index) {
                        var cell = el('div', 'pt-date');
                        cell.appendChild(el('div', 'pt-label', part[0]));
                        cell.appendChild(el('div', 'pt-value' + (part[1] === null ? ' pt-unset' : ''), part[1] !== null ? writeDay(part[1]) : 'Not set'));
                        range.appendChild(cell);
                        if (index === 0) { range.appendChild(el('div', 'pt-arrow', '\u2192')); }
                    });
                    card.appendChild(range);

                    if (start !== null && end !== null && end >= start) {
                        var months = Math.round((end - start) / (1000 * 60 * 60 * 24 * 30.44));
                        var days = Math.round((end - start) / (1000 * 60 * 60 * 24)) + 1;
                        card.appendChild(el('div', 'pt-length', months >= 1 ? months + (months === 1 ? ' month' : ' months') : days + (days === 1 ? ' day' : ' days')));
                    }
                    list.appendChild(card);
                });
                box.appendChild(list);
            });
        }
        document.addEventListener('change', function (event) {
            if (event.target.id === 'team-projects') { showProjectDates(); }
        });
        showProjectDates();

        // searchable dropdowns, like the rest of the app
        document.addEventListener('kimai.initialized', function (event) {
            const selects = event.detail.kimai.getPlugin('form-select');
            document.querySelectorAll('select.team-select').forEach(function (select) {
                selects.activateSelectPickerByElement(select);
                // roles: a typed role that is not in the list is added as it is (Enter), instead of picking the closest one
                if (select.dataset.create !== undefined && select.tomselect) {
                    select.tomselect.settings.addPrecedence = true;
                }
            });
        });
    </script>
{% endblock %}
