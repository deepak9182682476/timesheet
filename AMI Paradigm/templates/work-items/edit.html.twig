{% extends 'base.html.twig' %}

{# One item of a project's breakdown (an Epic, a Feature, a Lead ...): its name and who it is assigned to #}
{% block main %}
    {% set formOptions = {
        'title': (item.id is null ? 'Add ' ~ level_name : 'Edit ' ~ level_name),
        'form': form,
        'back': path('work_items', {'project': project.id})
    } %}
    {% embed 'default/_form.html.twig' with formOptions %}
        {% form_theme form 'form/horizontal.html.twig' %}
        {% block form_body %}
            <div class="mb-3 row">
                <label class="col-form-label col-sm-2">{{ 'project'|trans }}</label>
                <div class="col-sm-10 pt-2">
                    {{ project.name }} <span class="badge bg-blue-lt ms-1">{{ project_model_name(project) }}</span>
                </div>
            </div>
            {% for step in path %}
                <div class="mb-3 row">
                    <label class="col-form-label col-sm-2">{{ levels[step.level] ?? 'Item' }}</label>
                    <div class="col-sm-10 pt-2">{{ step.name }}</div>
                </div>
            {% endfor %}
            {% if form.names is defined %}{{ form_row(form.names) }}{% else %}{{ form_row(form.name) }}{% endif %}
            {# {{ form_row(form.users) }} - nothing is assigned to single people any more #}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
